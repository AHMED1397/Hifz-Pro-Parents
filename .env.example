# Copy to `.env` to connect the app to Supabase.
#
# WITHOUT these keys the app runs entirely on the built-in demo family in
# src/data/mock.ts — nothing breaks, every screen still works.
#
# WITH these keys the app reads live data. Parents are restricted to their own
# children by Row Level Security (supabase/schema.sql), so the project MUST be
# on the UUID schema with `parent_students` populated — NOT the legacy
# setup_schema.sql the Teacher app currently uses.
# See docs/PARENT_APP_PLAN.md gap G4.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Alternative name accepted for the classic anon key:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
